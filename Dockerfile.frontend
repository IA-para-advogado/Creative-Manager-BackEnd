# syntax=docker/dockerfile:1
# Multi-stage Dockerfile that clones the frontend repo during build via HTTPS with a token

# --- BASE STAGE ---
FROM node:20-alpine AS base

# Install git to clone
RUN apk add --no-cache git

WORKDIR /app

# Accept GitHub Token and branch name as build arguments
ARG GITHUB_TOKEN
ARG BRANCH=dev
ARG VITE_API_BACKEND

# Export the VITE_API_BACKEND to be used during the Vite build process
ENV VITE_API_BACKEND=${VITE_API_BACKEND}

# Clone the frontend repository using HTTPS and the GITHUB_TOKEN
RUN git clone -b ${BRANCH} https://${GITHUB_TOKEN}@github.com/IA-para-advogado/Creative-Manager-FrontEnd.git .

# Install dependencies (usando npm install como você sugeriu)
RUN npm install

# --- DEVELOPMENT RUNTIME ---
FROM base AS development
EXPOSE 5173
# Gera o .env dinamicamente com o valor da variável de ambiente do contêiner e inicia o dev server
CMD ["/bin/sh", "-c", "echo VITE_API_BACKEND=$VITE_API_BACKEND > /app/.env && npm run dev -- --host"]

# --- PRODUCTION RUNTIME ---
FROM nginx:1.25-alpine AS production
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
